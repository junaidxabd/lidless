<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lidless.helper</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/LidlessHelper</string>
	<key>MachServices</key>
	<dict>
		<key>com.lidless.helper</key>
		<true/>
	</dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.lidless.app</string>
	</array>
	<!-- RunAtLoad requests a boot-time recovery pass for a sentinel that
	     survives a crash or power loss. Actual recovery remains a live gate. -->
	<key>RunAtLoad</key>
	<true/>
	<!-- While an override sentinel, mutating-command marker, or scheduled-wake
	     reconciliation marker exists, PathState requests that launchd
	     keep/relaunch the helper. Actual relaunch and crash-recovery behavior
	     remain live validation gates. -->
	<key>KeepAlive</key>
	<dict>
		<key>PathState</key>
		<dict>
			<key>/var/db/lidless/override-active</key>
			<true/>
			<key>/var/db/lidless/mutation-in-flight.json</key>
			<true/>
			<key>/var/db/lidless/scheduled-wake-recovery-required.json</key>
			<true/>
		</dict>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
